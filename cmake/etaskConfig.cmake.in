@PACKAGE_INIT@

# The imported targets: etask and the elib chain it is exported with
# (ecomm -> etools -> eser), all header-only INTERFACE libraries.
include("${CMAKE_CURRENT_LIST_DIR}/etaskTargets.cmake")

# etask_add_schema() - the same function a FetchContent consumer gets, so a
# project reads identically whether etask was fetched or installed.
include("${CMAKE_CURRENT_LIST_DIR}/etask.cmake")

check_required_components(etask)
