{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarikTik/etask/schema/meta/etask.schema.json",
  "title": "etask schema v2",
  "description": "Grammar for etask code-generation schemas: a tree of scopes, abstract scopes and tasks.",
  "type": "object",
  "propertyNames": { "$ref": "#/$defs/identifier" },
  "additionalProperties": { "$ref": "#/$defs/node" },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
      "description": "A valid C++ identifier (becomes a namespace/class/directory)."
    },
    "typeName": {
      "type": "string",
      "enum": [
        "int", "int8", "int16", "int32", "int64",
        "uint8", "uint16", "uint32", "uint64",
        "float", "double", "bool"
      ]
    },
    "children": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/node" }
    },
    "params": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/typeName" },
      "description": "Ordered name -> type map. Declaration order is the wire contract."
    },
    "statusKey": {
      "type": "string",
      "pattern": "^(finished|aborted|task_finished|task_aborted|task_timeout|task_io_error|task_validation_failed|task_dependency_missing|task_busy|custom\\(\\s*(0[xX](7[0-9a-fA-F]|[89a-fA-F][0-9a-fA-F])|(11[2-9]|1[2-9][0-9]|2[0-4][0-9]|25[0-5]))\\s*\\))$",
      "description": "A status_code a completing task can send: the task/runtime range (finished and aborted alias task_finished/task_aborted), or custom(0xNN) in 0x70-0xFF. Manager/API codes - including ok - and the framework-owned result_too_large cannot key a shape."
    },
    "resultShape": {
      "oneOf": [
        {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/identifier" },
          "additionalProperties": { "$ref": "#/$defs/typeName" }
        },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/typeName" }
        }
      ],
      "description": "One result shape: named map or positional list of types (ordered - order is the wire contract)."
    },
    "returns": {
      "oneOf": [
        { "$ref": "#/$defs/resultShape" },
        {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/statusKey" },
          "additionalProperties": { "$ref": "#/$defs/resultShape" },
          "minProperties": 1,
          "description": "One shape per status code. The reply's status byte is what tells a peer which shape it received."
        }
      ],
      "description": "Either one result shape (carried by an ordinary completion, i.e. task_finished), or a mapping of status code -> shape. The two forms are told apart by the values: type strings mean a single shape, nested shapes mean status-keyed. Mixing them is an error."
    },
    "node": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "$ref": "#/$defs/scopeNode" },
        { "$ref": "#/$defs/abstractScopeNode" },
        { "$ref": "#/$defs/taskNode" }
      ]
    },
    "scopeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "scope" },
        "brief": { "type": "string" },
        "description": { "type": "string" },
        "children": { "$ref": "#/$defs/children" }
      }
    },
    "abstractScopeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "instances"],
      "properties": {
        "type": { "const": "abstract_scope" },
        "brief": { "type": "string" },
        "description": { "type": "string" },
        "instances": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "children": { "$ref": "#/$defs/children" }
      }
    },
    "taskNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "const": "task" },
        "brief": { "type": "string" },
        "description": { "type": "string" },
        "uid": { "type": "integer", "minimum": 0 },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "description": "How many instances of this task's uid may run concurrently (default 1). Lowered to capacity<T, N> in the generated task_list."
        },
        "params": { "$ref": "#/$defs/params" },
        "returns": { "$ref": "#/$defs/returns" }
      }
    }
  }
}
